BACKEND_URL=http://127.0.0.1:5002
# Optional: public Cloudinary cloud identifier, never an API secret.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Optional Corporate navbar destination. Defaults to http://localhost:3000/ in
# development and https://thegourmetgifts.co/ in production. Public build-time URL.
NEXT_PUBLIC_CORPORATE_SITE_URL=

# Public B2C origin used for canonical/social URLs. Confirmed storefront default:
NEXT_PUBLIC_SITE_URL=https://b2c-tau-weld.vercel.app
